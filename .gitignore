# Dependencies
node_modules/
.pnp/
.pnp.*

# Frontend build output
dist/
build/
.cache/
.vite/

# Rust and Tauri build output
target/
src-tauri/target/
src-tauri/target/**/data/

# Release artifacts are generated locally and uploaded as GitHub Release assets, not committed.
release/
*.msi
*.exe
*.dmg
*.app
*.deb
*.rpm
*.AppImage
*.zip
*.7z
*.tar
*.tar.gz
*.tgz


# GitHub Wiki is a separate repository clone and must not be committed with the main project.
# GitHub Wiki 是独立仓库的本地副本，不能随主项目仓库一起提交。
ClipAnchor.wiki/

# Local project prompt/specification file is for private development reference only.
# 本地项目提示词/需求文件仅用于私人开发参考，不应提交到主项目仓库。
ClipAnchor.md


# Local staging area for user-supplied extension language JSON files.
# 用户自行准备的扩展语言 JSON 暂存目录，仅保留在本地，不提交到 Git。
extension-locales/

# Portable runtime data must stay local because it may contain private clipboard content.
data/*
!data/.gitkeep
*.db
*.db-*
*.sqlite
*.sqlite3
*.log
logs/

# Environment and signing secrets
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.cer
*.crt
*.mobileprovision
*.provisionprofile

# Editor / AI tool directories are local workspace state, not ClipAnchor product source.
# Committing them would upload editor and agent config to GitHub.
# 编辑器与 AI 工具目录只是本机工作区状态，不是 ClipAnchor 产品源码。
# 提交这些目录会把编辑器和 Agent 配置推到 GitHub。
.cursor/
.vscode/
.claude/
.windsurf/
.codex/
.idea/
.continue/
.aider/
.gemini/
.agent/
.agents/
.augment/
.zed/
.fleet/

# OS files
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo

# Test and coverage output
coverage/
.nyc_output/
playwright-report/
test-results/
